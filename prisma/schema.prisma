generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
  SUPERADMIN
}

enum EventCategory {
  MUSIC
  SPORTS
  BUSINESS
  EDUCATION
  TECHNOLOGY
  FOOD
  ART
  HEALTH
  OTHER
}

enum TransactionStatus {
  WAITING_PAYMENT
  PAID
  CANCELLED
  EXPIRED
  DONE
}

model User {
  id              Int      @id @default(autoincrement())
  name            String
  email           String   @unique
  password        String
  profilePic      String?
  role            Role     @default(USER)
  referralCode    String   @unique

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  // Relations
  organizedEvents Event[]
  coupons         Coupon[]
  transactions    Transaction[]
  reviews         Review[]

  referralSent     ReferralUsage[] @relation("Referrer")
  referralReceived ReferralUsage[] @relation("Referred")

  @@map("users")
}

model Event {
  id            Int           @id @default(autoincrement())
  name          String        @unique
  description   String
  location      String
  category      EventCategory
  bannerImage   String

  startDate     DateTime
  endDate       DateTime

  organizerId   Int
  organizer      User @relation(fields: [organizerId], references: [id])

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  // Relations
  ticketTypes   TicketType[]
  vouchers      Voucher[]
  transactions  Transaction[]

  @@map("events")
}

model TicketType {
  id           Int      @id @default(autoincrement())
  name         String
  price        Int
  booked       Int      @default(0)
  totalTicket  Int

  eventId      Int
  event        Event    @relation(fields: [eventId], references: [id])

  deletedAt    DateTime?

  transactionItems TransactionItem[]

  @@map("ticket_types")
}

model Voucher {
  id         Int      @id @default(autoincrement())
  code       String   @unique
  discount   Int

  startDate  DateTime
  endDate    DateTime

  quota      Int

  eventId    Int
  event       Event @relation(fields: [eventId], references: [id])

  transactions Transaction[]

  @@map("vouchers")
}

model Coupon {
  id          Int      @id @default(autoincrement())
  discount    Int
  expiredAt   DateTime

  userId      Int
  user         User @relation(fields: [userId], references: [id])

  transactions Transaction[]

  @@map("coupons")
}

model Transaction {
  id            Int      @id @default(autoincrement())

  userId        Int
  eventId       Int

  voucherId     Int?
  couponId      Int?

  status        TransactionStatus

  totalPrice    Int
  paymentProof  String?
  pointUsed     Int?

  createdAt     DateTime @default(now())
  expiredAt     DateTime

  user          User @relation(fields: [userId], references: [id])
  event         Event @relation(fields: [eventId], references: [id])
  voucher       Voucher? @relation(fields: [voucherId], references: [id])
  coupon        Coupon? @relation(fields: [couponId], references: [id])

  items         TransactionItem[]
  review        Review?

  @@map("transactions")
}

model TransactionItem {
  id             Int @id @default(autoincrement())

  transactionId  Int
  ticketTypeId   Int

  qty            Int
  price          Int

  transaction     Transaction @relation(fields: [transactionId], references: [id])
  ticketType      TicketType @relation(fields: [ticketTypeId], references: [id])

  @@map("transaction_items")
}

model ReferralUsage {
  id          Int @id @default(autoincrement())

  referrerId  Int
  referredId  Int

  createdAt   DateTime @default(now())

  referrer    User @relation("Referrer", fields: [referrerId], references: [id])
  referred    User @relation("Referred", fields: [referredId], references: [id])

  @@map("referral_usages")
}

model Review {
  id             Int @id @default(autoincrement())

  rating         Int
  comment        String

  userId         Int
  transactionId  Int @unique

  createdAt      DateTime @default(now())

  user           User @relation(fields: [userId], references: [id])
  transaction    Transaction @relation(fields: [transactionId], references: [id])

  @@map("reviews")
}