generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               Int             @id @default(autoincrement())
  name             String
  email            String          @unique
  password         String
  profilePic       String?
  role             Role            @default(USER)
  referralCode     String          @unique
  createdAt        DateTime        @default(now())
  deletedAt        DateTime?
  updatedAt        DateTime        @updatedAt
  coupons          Coupon[]
  organizedEvents  Event[]
  referralReceived ReferralUsage[] @relation("Referred")
  referralSent     ReferralUsage[] @relation("Referrer")
  reviews          Review[]
  transactions     Transaction[]
  points           Int             @default(0)

  @@map("users")
}

model Event {
  id           Int           @id @default(autoincrement())
  name         String        @unique
  description  String
  location     String
  category     EventCategory
  bannerImage  String
  startDate    DateTime
  endDate      DateTime
  organizerId  Int
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?
  organizer    User          @relation(fields: [organizerId], references: [id])
  ticketTypes  TicketType[]
  transactions Transaction[]
  vouchers     Voucher[]

  @@map("events")
}

model TicketType {
  id               Int               @id @default(autoincrement())
  price            Int
  booked           Int               @default(0)
  totalTicket      Int
  eventId          Int
  deletedAt        DateTime?
  name             TicketName
  event            Event             @relation(fields: [eventId], references: [id])
  transactionItems TransactionItem[]

  @@map("ticket_types")
}

model Voucher {
  id           Int           @id @default(autoincrement())
  code         String        @unique
  discount     Int
  startDate    DateTime
  endDate      DateTime
  quota        Int
  eventId      Int
  transactions Transaction[]
  event        Event         @relation(fields: [eventId], references: [id])

  @@map("vouchers")
}

model Coupon {
  id           Int           @id @default(autoincrement())
  discount     Int
  expiredAt    DateTime
  userId       Int
  user         User          @relation(fields: [userId], references: [id])
  transactions Transaction[]

  @@map("coupons")
}

model Transaction {
  id           Int               @id @default(autoincrement())
  userId       Int
  eventId      Int
  voucherId    Int?
  couponId     Int?
  status       TransactionStatus
  totalPrice   Int
  paymentProof String?
  pointUsed    Int?
  createdAt    DateTime          @default(now())
  expiredAt    DateTime
  updatedAt    DateTime          @default(now()) @updatedAt
  review       Review?
  items        TransactionItem[]
  coupon       Coupon?           @relation(fields: [couponId], references: [id])
  event        Event             @relation(fields: [eventId], references: [id])
  user         User              @relation(fields: [userId], references: [id])
  voucher      Voucher?          @relation(fields: [voucherId], references: [id])

  @@map("transactions")
}

model TransactionItem {
  id            Int         @id @default(autoincrement())
  transactionId Int
  ticketTypeId  Int
  qty           Int
  price         Int
  ticketType    TicketType  @relation(fields: [ticketTypeId], references: [id])
  transaction   Transaction @relation(fields: [transactionId], references: [id])

  @@map("transaction_items")
}

model ReferralUsage {
  id           Int      @id @default(autoincrement())
  referrerId   Int
  referredId   Int
  createdAt    DateTime @default(now())
  expiredAt    DateTime
  isPointUsed  Boolean  @default(false)
  pointsEarned Int      @default(10000)
  referred     User     @relation("Referred", fields: [referredId], references: [id])
  referrer     User     @relation("Referrer", fields: [referrerId], references: [id])

  @@map("referral_usages")
}

model Review {
  id            Int         @id @default(autoincrement())
  rating        Int
  comment       String
  userId        Int
  transactionId Int         @unique
  createdAt     DateTime    @default(now())
  transaction   Transaction @relation(fields: [transactionId], references: [id])
  user          User        @relation(fields: [userId], references: [id])

  @@map("reviews")
}

enum Role {
  USER
  ADMIN
  SUPERADMIN
}

enum EventCategory {
  MUSIC
  SPORTS
  BUSINESS
  EDUCATION
  TECHNOLOGY
  FOOD
  ART
  HEALTH
  OTHER
}

enum TransactionStatus {
  WAITING_PAYMENT
  WAITING_CONFIRMATION
  DONE
  REJECTED
  EXPIRED
  CANCELLED
}

enum TicketName {
  GOLD
  SILVER
  BRONZE
  EARLY_BIRD
}
